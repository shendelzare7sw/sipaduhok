jadwal_pelajaran ||--|{ jadwal_kelas : jadwal_pelajaran_id
kelas ||--|{ jadwal_kelas : kelas_id
siswa ||--|{ presensi : siswa_id
kelas ||--|{ presensi : kelas_id
mata_pelajaran ||--o{ presensi : mata_pelajaran_id
users ||--|{ presensi : diinput_oleh
@enduml

