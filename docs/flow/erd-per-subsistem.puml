' ERD per Subsistem SIPADUHOK - detail kolom + PK/FK (gaya referensi Gambar 49)
' File ini berisi 6 diagram (satu @startuml per subsistem).
' Entitas dari subsistem lain yang dirujuk ditampilkan sebagai stub (nama saja).

@startuml erd-1
title ERD Subsistem A. Pengguna, Peran & Organisasi
!theme plain
hide circle
hide empty methods
skinparam linetype ortho

entity "roles" as roles {
  * id : bigint unsigned <<PK>>
  --
  * name : varchar
  * display_name : varchar
  * level : int
    description : text
    permissions : json
    created_at : timestamp
    updated_at : timestamp
}
entity "users" as users {
  * id : bigint unsigned <<PK>>
  --
  * name : varchar
    username : varchar
  * email : varchar
    personal_email : varchar
    foto_profil : varchar
    phone : varchar
    avatar : varchar
    last_login_at : timestamp
    last_login_ip : varchar
  * role : enum
    role_id : bigint unsigned <<FK>>
    email_verified_at : timestamp
  * password : varchar
    security_question : varchar
    security_answer : varchar
    security_pin : varchar
    password_changed_at : timestamp
  * is_active : tinyint
    remember_token : varchar
    created_at : timestamp
    updated_at : timestamp
    cabang_id : bigint unsigned <<FK>>
}
entity "cabang" as cabang {
  * id : bigint unsigned <<PK>>
  --
  * kode_cabang : varchar
  * nama_cabang : varchar
  * alamat : text
    telepon : varchar
  * is_active : tinyint
    created_at : timestamp
    updated_at : timestamp
}
entity "tenaga_pendidik" as tenaga_pendidik {
  * id : bigint unsigned <<PK>>
  --
  * user_id : bigint unsigned <<FK>>
    nip : varchar
  * nama_lengkap : varchar
  * jenis_kelamin : enum
    tempat_lahir : varchar
    tanggal_lahir : date
    alamat : text
    telepon : varchar
    email : varchar
    pendidikan_terakhir : varchar
    foto : varchar
    created_at : timestamp
    updated_at : timestamp
}
entity "siswa" as siswa {
  * id : bigint unsigned <<PK>>
  --
  * user_id : bigint unsigned <<FK>>
  * cabang_id : bigint unsigned <<FK>>
    kelas_id : bigint unsigned <<FK>>
  * nisn : varchar
    nis : varchar
  * nama_lengkap : varchar
  * jenis_kelamin : enum
  * tempat_lahir : varchar
  * tanggal_lahir : date
  * alamat : text
    agama : varchar
    pelajaran_agama : varchar
    nama_ayah : varchar
    nama_ibu : varchar
    telepon_orangtua : varchar
    foto : varchar
  * tanggal_masuk : date
  * status : enum
  * validasi_ujian_bendahara : tinyint
  * validasi_ujian_wali : tinyint
    tanggal_validasi_ujian_bendahara : timestamp
    tanggal_validasi_ujian_wali : timestamp
  * validasi_rapor_bendahara : tinyint
  * validasi_rapor_wali : tinyint
  * validasi_rapor_ketua : tinyint
    tanggal_validasi_rapor_ketua : timestamp
    validasi_rapor_ketua_oleh : bigint unsigned <<FK>>
    tanggal_validasi_rapor_bendahara : timestamp
    tanggal_validasi_rapor_wali : timestamp
    created_at : timestamp
    updated_at : timestamp
    validasi_ujian_oleh : bigint unsigned <<FK>>
    validasi_rapor_oleh : bigint unsigned <<FK>>
}
entity "student_parents" as student_parents {
  * id : bigint unsigned <<PK>>
  --
  * siswa_id : bigint unsigned <<FK>>
  * parent_id : bigint unsigned <<FK>>
  * relationship : varchar
  * is_primary : tinyint
  * is_financial_responsible : tinyint
  * can_access_academic : tinyint
    created_at : timestamp
    updated_at : timestamp
}
entity "tahun_ajaran" as tahun_ajaran {
  * id : bigint unsigned <<PK>>
  --
  * nama_tahun_ajaran : varchar
  * tanggal_mulai : date
  * tanggal_selesai : date
    tanggal_mulai_genap : date
    tanggal_akhir_pts_ganjil : date
    tanggal_akhir_pts_genap : date
  * is_active : tinyint
    created_at : timestamp
    updated_at : timestamp
}
entity "kelas" as kelas <<external>>

roles ||--o{ users : role_id
cabang ||--o{ users : cabang_id
users ||--|{ tenaga_pendidik : user_id
users ||--|{ siswa : user_id
cabang ||--|{ siswa : cabang_id
kelas ||--o{ siswa : kelas_id
users ||--o{ siswa : validasi_rapor_ketua_oleh
users ||--o{ siswa : validasi_ujian_oleh
users ||--o{ siswa : validasi_rapor_oleh
siswa ||--|{ student_parents : siswa_id
users ||--|{ student_parents : parent_id
@enduml

@startuml erd-2
