@startuml
title Sequence Diagram - Input Nilai Akademik
autonumber

actor "Guru" as Guru
boundary "UI_InputNilai" as UI
control "Control_Nilai" as Control
entity "T_Siswa" as E_Siswa
entity "T_NilaiAkademik" as E_Nilai

== Skenario: Menampilkan Daftar & Rekap Nilai ==
Guru -> UI : 1. Mengakses Dashboard LMS (Tab Nilai Akademik)
activate UI
UI -> Control : 2. RequestDaftarSiswaDanNilai(Kelas)
activate Control
Control -> E_Siswa : 3. AmbilDaftarSiswa()
activate E_Siswa
E_Siswa --> Control : 4. DataSiswaDitemukan(Data)
deactivate E_Siswa
Control -> E_Nilai : 5. AmbilRekapNilaiSemester()
activate E_Nilai
E_Nilai --> Control : 6. DataNilaiDitemukan(Data)
deactivate E_Nilai
Control --> UI : 7. TampilkanTabelNilai(DataSiswa, DataNilai)
deactivate Control
UI --> Guru : 8. Halaman Rekap Nilai Terbuka
deactivate UI

== Skenario: Memasukkan/Mengubah Nilai ==
Guru -> UI : 9. Memilih Metode Input Nilai (Individual / Massal / Excel)
activate UI

alt Metode Input Individual
    Guru -> UI : 10. Klik "Edit" pada Baris Siswa & Isi Form Nilai
    UI -> Control : 11. SubmitNilaiIndividual(ID_Siswa, DataNilai)
    activate Control
else Metode Input Massal di Tabel
    Guru -> UI : 12. Mengisi Angka Langsung di Tabel & Klik "Simpan Semua"
    UI -> Control : 13. SubmitNilaiMassal(Array_DataNilai)
else Metode Import Excel
    Guru -> UI : 14. Download Template & Mengunggah File Excel Berisi Nilai
    UI -> Control : 15. ImportFileExcel(File)
end

Control -> Control : 16. Memvalidasi Format Angka (0-100)
Control -> E_Nilai : 17. Insert / Update DataNilai()
activate E_Nilai
deactivate E_Nilai
note right of E_Nilai : Konvensi Assumed Success diterapkan

Control -> Control : 18. Hitung Ulang Rata-Rata & Nilai Akhir Otomatis
Control -> E_Nilai : 19. Sinkronisasi Perubahan ke Dashboard Wali Kelas
activate E_Nilai
deactivate E_Nilai

Control --> UI : 20. UpdateTampilanData()
deactivate Control
UI --> Guru : 21. Tabel Diperbarui (Pemutakhiran Rata-Rata)
deactivate UI

== Skenario: Hitung Ulang Manual (Opsional) ==
Guru -> UI : 22. Klik "Hitung Ulang (Recalculate)"
activate UI
UI -> Control : 23. RequestKalkulasiUlang()
activate Control
Control -> Control : 24. Memperbarui Kalkulasi
Control --> UI : 25. NotifikasiSukses()
deactivate Control
UI --> Guru : 26. Pesan Sukses
deactivate UI

@enduml
