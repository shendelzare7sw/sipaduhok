@startuml activity-mengikuti-kelas-virtual
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Siswa)|
start
:Mengakses Menu\n"Kelas Virtual (Meeting)";

|Sistem|
:Menarik Data Jadwal Meeting\nBerdasarkan Kelas & Mata Pelajaran Siswa;
:Mengecek Status Waktu Pelaksanaan\n(Akan Datang / Sedang Berlangsung / Selesai);
:Menampilkan Daftar Kelas Virtual\nLengkap dengan Label Status dan Waktu;

|Pengguna (Siswa)|
:Membaca Daftar Jadwal Meeting;

if (Apakah Status Meeting?) then (Sedang Berlangsung)
    :Klik Tombol "Masuk Meeting";

    |Sistem|
    :Membuka Jendela/Tab Baru (Redirect)\nmenuju URL Platform Meeting (Zoom/GMeet);

    |Pengguna (Siswa)|
    :Siswa Masuk ke Ruang Rapat (Virtual Room)\ndan Berinteraksi Secara Langsung (Live);

elseif (Apakah Status Meeting?) then (Akan Datang / Selesai)
    |Sistem|
    :Men-disable (Mengunci) Tombol Link Masuk;

    |Pengguna (Siswa)|
    :Hanya Dapat Membaca Informasi\n(Peringatan "Link Kedaluwarsa" / "Belum Mulai");
endif

|Pengguna (Siswa)|
:Selesai Mengakses Menu Kelas Virtual;
stop
@enduml
