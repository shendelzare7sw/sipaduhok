@startuml activity-kelola-tagihan-pembayaran
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Bendahara / Admin)|
start
:Mengakses Menu\nTagihan & Pembayaran;

|Sistem|
:Menampilkan Dropdown Menu\n(Tagihan, Pembayaran Masuk,\nTarik Tunggakan, Config);

|Pengguna (Bendahara / Admin)|
:Memilih Sub-Menu\n(Decision);

if (Sub-Menu?) then (Data Tagihan)
    |Sistem|
    :Menampilkan Halaman\nData Tagihan;
    |Pengguna (Bendahara / Admin)|
    :Pilih Aksi\n(Generate SPP / Tagihan Custom);
    |Sistem|
    :Menampilkan Form Pembuatan Tagihan;
    repeat
        |Pengguna (Bendahara / Admin)|
        :Mengisi Data Tagihan\n(Nominal, Bulan, Siswa);
        :Klik "Generate / Simpan";
        |Sistem|
        :Validasi Input & Duplikasi;
        if (Valid?) then (Tidak Valid / Duplikat)
            :Menampilkan Pesan Error\n(Contoh: Tagihan bulan ini sudah ada);
            |Pengguna (Bendahara / Admin)|
            :Memperbaiki Input;
        else (Ya, Valid)
            :Menyimpan Data Tagihan ke Database;
            :Menampilkan Pesan Sukses;
            break
        endif
    repeat while (Data Belum Valid)

elseif (Sub-Menu?) then (Pembayaran Masuk)
    |Sistem|
    :Menampilkan Halaman\nPembayaran Masuk;
    |Pengguna (Bendahara / Admin)|
    :Melihat Daftar Pembayaran\n(Status: Menunggu Validasi);
    :Klik "Validasi" pada\nsalah satu pembayaran;
    |Sistem|
    :Menampilkan Detail Bukti Transfer;
    |Pengguna (Bendahara / Admin)|
    if (Keputusan Validasi?) then (Setujui / Lunas)
        |Sistem|
        :Mengubah Status Pembayaran\nmenjadi Lunas;
        :Update Saldo & Status Tagihan Siswa;
        :Menampilkan Pesan Sukses;
    else (Tolak)
        |Sistem|
        :Mengubah Status Pembayaran\nmenjadi Ditolak;
        :Menampilkan Pesan Penolakan;
    endif

elseif (Sub-Menu?) then (Tarik Tunggakan)
    |Sistem|
    :Menampilkan Halaman\nCarryover Tunggakan;
    |Pengguna (Bendahara / Admin)|
    :Klik "Preview Tunggakan" dari\nTahun Ajaran Sebelumnya;
    |Sistem|
    :Menampilkan Daftar Siswa\nyang Memiliki Tunggakan;
    |Pengguna (Bendahara / Admin)|
    :Klik "Eksekusi Tarik Tunggakan";
    |Sistem|
    :Memindahkan Sisa Tagihan\nke Tahun Ajaran Saat Ini;
    :Menampilkan Pesan Sukses;

else (Config Pembayaran)
    |Sistem|
    :Menampilkan Form\nConfigurasi Bank / Paywuz;
    |Pengguna (Bendahara / Admin)|
    :Memperbarui Data Rekening\natau API Key Paywuz;
    :Klik "Simpan Konfigurasi";
    |Sistem|
    :Menyimpan Konfigurasi;
    :Menampilkan Pesan Sukses;
endif

|Pengguna (Bendahara / Admin)|
:Selesai;
stop
@enduml
