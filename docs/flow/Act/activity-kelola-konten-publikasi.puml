@startuml activity-kelola-konten-publikasi
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Admin / Sekretaris)|
start
:Mengakses Menu\nKelola Konten Publikasi;

|Sistem|
:Menampilkan Dropdown Menu\nKonten Publikasi;

|Pengguna (Admin / Sekretaris)|
:Memilih Sub-Menu\n(Kalender / Pengumuman / Flyer / Berita);

|Sistem|
:Menampilkan Daftar Data\nSesuai Sub-Menu yang Dipilih;

|Pengguna (Admin / Sekretaris)|
if (Pilih Aksi?) then (Tambah)
    |Sistem|
    :Menampilkan Form Tambah\nData Konten;
    |Pengguna (Admin / Sekretaris)|
    :Isi Form Data Konten;
    :Klik Tombol Simpan;
    |Sistem|
    if (Proses?) then (Berhasil)
        :Memperbarui Data Konten;
    else (Gagal)
        :Menampilkan Pesan Error;
        stop
    endif

elseif (Pilih Aksi?) then (Edit)
    |Pengguna (Admin / Sekretaris)|
    :Klik ikon Edit pada\nData Konten;
    |Sistem|
    :Menampilkan Form Edit\nData Konten;
    |Pengguna (Admin / Sekretaris)|
    :Mengubah Data Konten;
    :Klik Tombol Simpan;
    |Sistem|
    if (Proses?) then (Berhasil)
        :Memperbarui Data Konten;
    else (Gagal)
        :Menampilkan Pesan Error;
        stop
    endif

else (Hapus)
    |Pengguna (Admin / Sekretaris)|
    :Klik ikon Hapus pada\nData Konten;
    |Sistem|
    :Menampilkan Pop-up\nKonfirmasi Hapus;
    |Pengguna (Admin / Sekretaris)|
    if (Hapus atau Batal?) then (Hapus)
        |Sistem|
        :Menghapus Data;
        if (Proses?) then (Berhasil)
            :Memperbarui Data Konten;
        else (Gagal)
            :Menampilkan Pesan Error;
            stop
        endif
    else (Batal)
        :Kembali ke Daftar\nData Konten;
        stop
    endif
endif

|Pengguna (Admin / Sekretaris)|
:Selesai;
stop
@enduml
