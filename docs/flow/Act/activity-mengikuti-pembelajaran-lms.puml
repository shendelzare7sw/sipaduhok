@startuml activity-mengikuti-pembelajaran-lms
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Siswa)|
start
:Mengakses Menu "Dashboard LMS";

|Sistem|
:Menarik Data Mata Pelajaran\nBerdasarkan Kelas & Filter Agama;
:Menampilkan Daftar Mata Pelajaran;

|Pengguna (Siswa)|
:Memilih Mata Pelajaran Tertentu;

|Sistem|
:Memuat Seluruh Modul Pembelajaran\n(Materi, Tugas, Latihan, dan Ujian);
:Menampilkan Halaman Detail Mata Pelajaran;

|Pengguna (Siswa)|
:Mengeksplorasi Halaman Mapel\ndan Memilih Modul Belajar;

if (Pilihan Modul Belajar?) then (Materi)
    :Membaca Teks Pendalaman, Menonton Video,\natau Mengunduh File Lampiran dari Guru;
elseif (Pilihan Modul?) then (Tugas)
    :Membaca Instruksi Tugas dan\nMengunggah File Jawaban (Sebelum Deadline);
elseif (Pilihan Modul?) then (Latihan)
    :Mengerjakan Soal Simulasi (Latihan)\nUntuk Mengukur Pemahaman Mandiri;
elseif (Pilihan Modul?) then (Ujian)
    :Mengerjakan Soal Evaluasi Resmi\n(Misal: PTS / PAS) dengan Pengawasan Waktu;
endif

|Sistem|
:Merekam Riwayat Aktivitas dan Menyimpan Jawaban/Nilai;
:Memperbarui Indikator Progress Belajar Siswa;

|Pengguna (Siswa)|
:Selesai Mengikuti Pembelajaran di LMS;
stop
@enduml
