@startuml activity-kelola-pengaturan-kenaikan
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Admin)|
start
:Mengakses Menu\nPengaturan Kenaikan Kelas;

|Sistem|
:Menampilkan Sub-Menu\n(Pengaturan KKM & Syarat Kenaikan);

|Pengguna (Admin)|
:Memilih Sub-Menu\n(Decision);

if (Pilihan?) then (Pengaturan KKM)
    |Sistem|
    :Memuat Data Mata Pelajaran\ndan Batas Nilai KKM Saat Ini;

    repeat
        |Pengguna (Admin)|
        :Memasukkan/Mengubah Batas\nNilai KKM per Mata Pelajaran;
        :Klik "Simpan KKM";

        |Sistem|
        :Memvalidasi Input KKM;
        if (Data Valid?) then (Ya)
            :Menyimpan KKM ke Database;
            :Menampilkan Pesan Sukses;
            break
        else (Tidak)
            :Menampilkan Pesan Error\n(Input Tidak Sesuai Format);
            |Pengguna (Admin)|
            :Memperbaiki Input Nilai KKM;
        endif
    repeat while (Simpan Ulang)

else (Syarat Kenaikan)
    |Sistem|
    :Memuat Aturan Kelulusan Global\n(Persentase Tuntas, Syarat Keuangan, dll);

    repeat
        |Pengguna (Admin)|
        :Mengubah Parameter Syarat Kenaikan\n(Misal: Minimal 75% Mapel Harus Tuntas);
        :Klik "Simpan Pengaturan";

        |Sistem|
        :Memvalidasi Parameter Syarat;
        if (Data Valid?) then (Ya)
            :Menyimpan Pengaturan ke Database;
            :Menampilkan Pesan Sukses;
            break
        else (Tidak)
            :Menampilkan Pesan Error\n(Nilai Persentase Tidak Valid);
            |Pengguna (Admin)|
            :Memperbaiki Input Parameter;
        endif
    repeat while (Simpan Ulang)
endif

|Pengguna (Admin)|
:Selesai Melakukan\nPengaturan Kenaikan Kelas;
stop
@enduml
