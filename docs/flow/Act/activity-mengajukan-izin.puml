@startuml activity-mengajukan-izin
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Wali Murid)|
start
:Mengakses Menu\nPresensi Anak;

|Sistem|
:Mengecek Jumlah Anak yang Terdaftar;
if (Lebih dari 1 Anak?) then (Ya)
    :Menampilkan Pilihan Anak;
    |Pengguna (Wali Murid)|
    :Memilih Profil Anak Tertentu;
else (Hanya 1)
endif

|Sistem|
:Menampilkan Sub-Menu\n(Riwayat Presensi & Pengajuan Izin);

|Pengguna (Wali Murid)|
:Memilih Sub-Menu\n(Decision);

if (Pilihan?) then (Melihat Riwayat)
    |Sistem|
    :Memuat Data Riwayat Kehadiran\n(Hadir, Sakit, Izin, Alpha);
    |Pengguna (Wali Murid)|
    :Memantau Rekam Jejak\nKehadiran Anak;
    
else (Mengajukan Izin)
    |Pengguna (Wali Murid)|
    :Klik Tombol "Ajukan Izin";
    
    |Sistem|
    :Menampilkan Form Pengajuan Izin;
    
    repeat
        |Pengguna (Wali Murid)|
        :Memilih Kategori (Sakit / Izin);
        :Mengisi Tanggal (Mulai - Selesai);
        :Mengunggah Bukti Surat / Foto\n(Wajib untuk kategori Sakit);
        :Menulis Keterangan Tambahan;
        :Klik "Kirim Pengajuan";
        
        |Sistem|
        :Memvalidasi Input dan Ukuran/Format File;
        if (Data Valid?) then (Ya)
            :Menyimpan Pengajuan Izin\n(Status Validasi: Pending);
            :Mengirim Notifikasi kepada\nWali Kelas yang Bersangkutan;
            :Menampilkan Pesan Sukses;
            break
        else (Tidak)
            :Menampilkan Pesan Error\n(File Terlalu Besar / Input Kosong);
            |Pengguna (Wali Murid)|
            :Memperbaiki Form Pengajuan;
        endif
    repeat while (Kirim Ulang)
endif

|Pengguna (Wali Murid)|
:Selesai Melakukan\nPengelolaan Presensi Anak;
stop
@enduml
