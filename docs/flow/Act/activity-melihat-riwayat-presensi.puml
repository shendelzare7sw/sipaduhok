@startuml activity-melihat-riwayat-presensi
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Siswa)|
start
:Mengakses Menu "Riwayat Presensi";

|Sistem|
:Menarik Data Riwayat Presensi\nBerdasarkan ID Siswa (Tabel 'presensi');
:Mengurutkan Data dari yang Terbaru\n(Descending berdasarkan Tanggal);
:Mengkalkulasi Rekapitulasi Kehadiran\n(Total Hadir, Izin, Sakit, Alpa) per Bulan;
:Menampilkan Halaman Riwayat Presensi\n(Tabel Harian & Ringkasan Bulanan);

|Pengguna (Siswa)|
:Membaca Data Riwayat Kehadiran Harian;

if (Apakah Menggunakan Paginasi?) then (Ya)
    :Klik Navigasi Paginasi Tabel\n(Misal: Next Page / Halaman 2);
    
    |Sistem|
    :Memuat Blok Data Selanjutnya\n(Batas 20 Baris per Halaman);
    :Memperbarui Tampilan Tabel;
else (Tidak)
endif

|Pengguna (Siswa)|
:Selesai Melakukan Pengecekan\nRiwayat Kehadiran Pribadi;
stop
@enduml
