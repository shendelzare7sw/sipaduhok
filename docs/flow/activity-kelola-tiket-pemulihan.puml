@startuml activity-kelola-tiket-pemulihan
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Admin|
start
:Mengakses Menu\nTiket Pemulihan Akun;

|Sistem|
:Menampilkan Daftar\nAntrean Permintaan Tiket;

|Admin|
:Memilih Tiket dari Daftar;
:Mengecek Detail Kendala\n(Misal: Lupa Password);

if (Tindakan Admin?) then (Kirim Ulang)
    |Admin|
    :Klik Tombol "Kirim Ulang";
    
    |Sistem|
    :Memproses Pengiriman Ulang\n(Reset Password/Tautan);
    :Memperbarui Status Tiket\nMenjadi "Terkirim Otomatis";
    
else (Tutup Tiket)
    |Admin|
    :Klik Tombol "Tutup Tiket";
    
    |Sistem|
    :Memperbarui Status Tiket\nMenjadi "Ditutup";
endif

|Sistem|
:Menampilkan Pesan\nNotifikasi Sukses;
:Memperbarui Tampilan\nDaftar Tiket;

|Admin|
:Melihat Hasil Update;
stop
@enduml
