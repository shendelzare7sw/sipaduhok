@startuml
title Sequence Diagram - Melihat Jadwal Kelas
autonumber

actor "Siswa / Guru / Wali Kelas" as Pengguna
boundary "UI_Jadwal" as UI
control "Control_Jadwal" as Control
entity "T_JadwalPelajaran" as E_Jadwal

Pengguna -> UI : 1. Mengakses Menu "Jadwal Kelas / Jadwal Mengajar"
activate UI
UI -> Control : 2. RequestDataJadwal(ID_Pengguna, Role)
activate Control

Control -> Control : 3. Identifikasi Role Pengguna
alt Role = Siswa
    Control -> E_Jadwal : 4. AmbilJadwalSiswa(ID_Kelas)
    activate E_Jadwal
    E_Jadwal --> Control : 5. DataJadwal
    deactivate E_Jadwal
else Role = Guru
    Control -> E_Jadwal : 6. AmbilJadwalMengajar(ID_Guru)
    activate E_Jadwal
    E_Jadwal --> Control : 7. DataJadwal
    deactivate E_Jadwal
else Role = Wali Kelas
    Control -> E_Jadwal : 8. AmbilJadwalWali(ID_KelasDiampu)
    activate E_Jadwal
    E_Jadwal --> Control : 9. DataJadwal
    deactivate E_Jadwal
end

Control -> Control : 10. Menyusun Format Data (Tabel / Kalender)
Control --> UI : 11. TampilkanJadwalPelajaran()
deactivate Control

UI --> Pengguna : 12. Halaman Jadwal Terbuka
Pengguna -> UI : 13. Membaca Jadwal Pelajaran

alt Membutuhkan Filter/Cetak
    Pengguna -> UI : 14. Memilih Filter Hari atau Klik "Cetak"
    UI -> Control : 15. EksekusiFilterAtauCetak()
    activate Control
    Control --> UI : 16. UpdateTampilan / File Cetak
    deactivate Control
    UI --> Pengguna : 17. Menampilkan Hasil Filter / Dokumen
end
deactivate UI
@enduml
