@startuml
title Sequence Diagram - UC02: Kelola Tiket Pemulihan Akun
autonumber

actor "Admin" as Admin
boundary "UI_KelolaTiket" as UI
control "Control_KelolaTiket" as Control
entity "T_Tiket" as Entity

== Skenario: Menampilkan Daftar Antrean Tiket ==

Admin -> UI : 1. Mengakses Menu Tiket Pemulihan Akun
activate UI
UI -> Control : 2. RequestDaftarTiket()
activate Control
Control -> Entity : 3. AmbilDataAntrean()
activate Entity
Entity --> Control : 4. DataDitemukan(Data)
deactivate Entity
Control --> UI : 5. TampilkanDaftarTiket(Data)
deactivate Control
UI --> Admin : 6. Daftar Antrean Terbuka
deactivate UI

== Skenario: Memproses Tiket (Kirim Ulang / Tutup) ==

Admin -> UI : 7. Memilih Tiket dan Mengecek Detail
Admin -> UI : 8. Klik Tindakan (Kirim Ulang / Tutup Tiket)
activate UI
UI -> Control : 9. ProsesTindakanTiket(ID, Tindakan)
activate Control

alt Tindakan = Kirim Ulang
    Control -> Control : 10. Memproses Pengiriman (Reset Password/Link)
    Control -> Entity : 11. UpdateStatus(ID, "Terkirim Otomatis")
    activate Entity
    deactivate Entity
else Tindakan = Tutup Tiket
    Control -> Entity : 12. UpdateStatus(ID, "Ditutup")
    activate Entity
    deactivate Entity
end

Control --> UI : 13. Notifikasi Sukses()
deactivate Control
UI --> Admin : 14. Memperbarui Tampilan Daftar Tiket (Tabel Refresh)
deactivate UI

@enduml
