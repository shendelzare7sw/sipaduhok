@startuml
title Sequence Diagram - UC17: Kelola Pengaturan Kenaikan Kelas
autonumber

actor "Admin / Waka" as Admin
boundary "UI_PengaturanKenaikan" as UI
control "Control_Pengaturan" as Control
entity "T_KKM" as E_KKM
entity "T_SyaratKenaikan" as E_Syarat

== Skenario: Menampilkan Sub-Menu Pengaturan ==

Admin -> UI : 1. Mengakses Menu Pengaturan Kenaikan Kelas
activate UI
UI --> Admin : 2. Menampilkan Pilihan Sub-Menu (KKM / Syarat Kenaikan)
deactivate UI

== Skenario: Pengaturan KKM (Kriteria Ketuntasan Minimal) ==

Admin -> UI : 3. Memilih Sub-Menu "Pengaturan KKM"
activate UI
UI -> Control : 4. RequestDataKKM()
activate Control
Control -> E_KKM : 5. AmbilDataMapelDanKKM()
activate E_KKM
E_KKM --> Control : 6. DataDitemukan(Data)
deactivate E_KKM
Control --> UI : 7. TampilkanFormKKM(Data)
deactivate Control

Admin -> UI : 8. Memasukkan/Mengubah Batas Nilai KKM per Mapel
Admin -> UI : 9. Klik "Simpan KKM"
UI -> Control : 10. SimpanDataKKM(Data)
activate Control

Control -> Control : 11. Memvalidasi Input KKM
alt Validasi Gagal (Input Tidak Sesuai Format)
    Control --> UI : 12. ErrorValidasi("Format nilai KKM salah")
    UI --> Admin : 13. Menampilkan Pesan Error (Meminta Perbaikan Input)
else Validasi Berhasil
    Control -> E_KKM : 14. UpdateDataKKM(Data)
    activate E_KKM
    deactivate E_KKM
    note right of E_KKM : Assumed Success

    Control --> UI : 15. NotifikasiSukses()
    UI --> Admin : 16. Menampilkan Pesan Sukses & Form Terbarui
end
deactivate Control
deactivate UI

== Skenario: Pengaturan Syarat Kenaikan (Global) ==

Admin -> UI : 17. Memilih Sub-Menu "Syarat Kenaikan"
activate UI
UI -> Control : 18. RequestDataSyarat()
activate Control
Control -> E_Syarat : 19. AmbilAturanKelulusanGlobal()
activate E_Syarat
E_Syarat --> Control : 20. DataDitemukan(Data)
deactivate E_Syarat
Control --> UI : 21. TampilkanFormSyarat(Data)
deactivate Control

Admin -> UI : 22. Mengubah Parameter Syarat Kenaikan (Misal: 75% Tuntas)
Admin -> UI : 23. Klik "Simpan Pengaturan"
UI -> Control : 24. SimpanDataSyarat(Data)
activate Control

Control -> Control : 25. Memvalidasi Parameter Syarat
alt Validasi Gagal (Nilai Persentase Tidak Valid)
    Control --> UI : 26. ErrorValidasi("Nilai persentase/parameter tidak valid")
    UI --> Admin : 27. Menampilkan Pesan Error (Meminta Perbaikan Input)
else Validasi Berhasil
    Control -> E_Syarat : 28. UpdateAturanSyarat(Data)
    activate E_Syarat
    deactivate E_Syarat
    note right of E_Syarat : Assumed Success

    Control --> UI : 29. NotifikasiSukses()
    UI --> Admin : 30. Menampilkan Pesan Sukses & Form Terbarui
end
deactivate Control
deactivate UI

@enduml
