@startuml
title Sequence Diagram - Kelola Jadwal Pelajaran
autonumber

actor "Admin" as Admin
boundary "UI_KelolaJadwal" as UI
control "Control_Jadwal" as Control
entity "T_JadwalPelajaran" as E_Jadwal
entity "T_PenugasanGuru" as E_Guru
entity "T_LogJadwal" as E_Log

== Skenario: Menampilkan Jadwal Aktif ==
Admin -> UI : 1. Mengakses Menu Jadwal Pelajaran
activate UI
UI -> Control : 2. RequestDataJadwal()
activate Control
Control -> E_Jadwal : 3. AmbilJadwalTahunAjaranAktif()
activate E_Jadwal
E_Jadwal --> Control : 4. ReturnData()
deactivate E_Jadwal
Control --> UI : 5. TampilkanHalamanJadwal(Data)
deactivate Control
UI --> Admin : 6. Jadwal Pelajaran Terbuka
deactivate UI

== Skenario A: Tambah Jadwal Baru (dengan Validasi Berlapis) ==
Admin -> UI : 7. Memilih Aksi "Tambah Jadwal" & Mengisi Form
activate UI
UI -> Control : 8. SubmitJadwalBaru(Data)
activate Control

Control -> Control : 9. Validasi Kesesuaian Jenjang (Mapel vs Kelas)
alt Tidak Sesuai
    Control --> UI : 10. ReturnPesanError("Mapel tidak sesuai jenjang")
    UI --> Admin : 11. Menampilkan Pesan Error
else Sesuai
    Control -> Control : 12. Validasi Bentrok (Guru & Kelas pada Hari/Jam sama)
    alt Ada Bentrok
        Control --> UI : 13. ReturnPesanError("Guru/Kelas sudah terisi")
        UI --> Admin : 14. Menampilkan Pesan Error
    else Tidak Ada Bentrok (Aman)
        Control -> E_Jadwal : 15. InsertDataJadwal()
        activate E_Jadwal
        deactivate E_Jadwal
        note right of E_Jadwal : Konvensi Assumed Success diterapkan

        Control -> E_Guru : 16. SinkronisasiOtomatisRelasiGuru()
        activate E_Guru
        deactivate E_Guru

        Control --> UI : 17. NotifikasiSukses()
        UI --> Admin : 18. Pesan Sukses
    end
end
deactivate Control
deactivate UI

== Skenario B: Ganti Guru Khusus (Individual) ==
Admin -> UI : 19. Klik "Ganti Guru" pada Slot Tertentu
activate UI
Admin -> UI : 20. Memilih Guru Pengganti, Mengisi Alasan, Klik Simpan
UI -> Control : 21. SubmitGantiGuru(ID_Jadwal, GuruBaru, Alasan)
activate Control

Control -> Control : 22. Validasi Bentrok Guru Baru
alt Ada Bentrok
    Control --> UI : 23. ReturnPesanError("Guru bentrok di waktu tersebut")
    UI --> Admin : 24. Menampilkan Pesan Error
else Tidak Bentrok (Aman)
    Control -> E_Jadwal : 25. UpdateGuruJadwal()
    activate E_Jadwal
    deactivate E_Jadwal

    Control -> E_Log : 26. InsertLogRiwayatPerubahan()
    activate E_Log
    deactivate E_Log

    Control -> E_Guru : 27. SinkronisasiUlangRelasiGuru()
    activate E_Guru
    deactivate E_Guru

    Control --> UI : 28. NotifikasiSukses()
    UI --> Admin : 29. Pesan Sukses
end
deactivate Control
deactivate UI

== Skenario C: Ganti Guru Massal (Bulk Replace) ==
Admin -> UI : 30. Klik "Bulk Replace Guru"
activate UI
Admin -> UI : 31. Memilih Guru Lama & Guru Baru, Klik Proses
UI -> Control : 32. SubmitGantiMassal(GuruLama, GuruBaru)
activate Control

Control -> Control : 33. Memeriksa Bentrok Semua Jadwal Terkait
alt Ada Bentrok (Salah Satu Jadwal)
    Control --> UI : 34. ReturnPesanError("Bentrok terdeteksi, Ganti Massal dibatalkan")
    UI --> Admin : 35. Menampilkan Detail Bentrok
else Tidak Ada Bentrok (Aman Seluruhnya)
    Control -> E_Jadwal : 36. UpdateMassalJadwal()
    activate E_Jadwal
    deactivate E_Jadwal

    Control -> E_Log : 37. InsertLogRiwayatMassal()
    activate E_Log
    deactivate E_Log

    Control -> E_Guru : 38. SinkronisasiUlangRelasiGuru()
    activate E_Guru
    deactivate E_Guru

    Control --> UI : 39. NotifikasiSukses()
    UI --> Admin : 40. Pesan Sukses
end
deactivate Control
deactivate UI

== Skenario D: Hapus Jadwal ==
Admin -> UI : 41. Klik ikon Hapus pada Jadwal Tertentu
activate UI
UI --> Admin : 42. Menampilkan Konfirmasi Hapus
alt Hapus = Ya
    Admin -> UI : 43. Mengonfirmasi Penghapusan
    UI -> Control : 44. ProsesHapusJadwal(ID_Jadwal)
    activate Control

    Control -> E_Jadwal : 45. DeleteData()
    activate E_Jadwal
    deactivate E_Jadwal

    Control -> E_Guru : 46. BersihkanRelasiGuru(Bila tidak ada jadwal lain)
    activate E_Guru
    deactivate E_Guru

    Control --> UI : 47. NotifikasiSukses()
    deactivate Control
    UI --> Admin : 48. Jadwal Dihapus & Pesan Sukses
else Batal
    Admin -> UI : 49. Klik Batal
    UI --> Admin : 50. Kembali ke Halaman Jadwal
end
deactivate UI

@enduml
