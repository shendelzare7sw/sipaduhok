@startuml
title Sequence Diagram - Kelola Latihan
autonumber

actor "Guru" as Guru
boundary "UI_KelolaLatihan" as UI
control "Control_Latihan" as Control
entity "T_Latihan" as E_Latihan
entity "Service_AI" as AI

== Skenario: Menampilkan Daftar Latihan ==

Guru -> UI : 1. Mengakses Dashboard LMS (Tab Latihan)
activate UI
UI -> Control : 2. RequestDaftarLatihan(Kelas)
activate Control
Control -> E_Latihan : 3. AmbilDataLatihan()
activate E_Latihan
E_Latihan --> Control : 4. DataLatihanDitemukan(Data)
deactivate E_Latihan
Control --> UI : 5. TampilkanDaftarLatihan(Data)
deactivate Control
UI --> Guru : 6. Daftar Latihan Terbuka
deactivate UI

== Skenario A: Buat Set Latihan Baru & Manajemen Soal ==

Guru -> UI : 7. Klik "Buat Latihan" & Mengisi Pengaturan
activate UI
UI -> Control : 8. SimpanPengaturanLatihan(DataAturan)
activate Control
Control -> E_Latihan : 9. InsertLatihanBaru()
activate E_Latihan
E_Latihan --> Control : 10. Kembalikan ID_Latihan
deactivate E_Latihan
Control --> UI : 11. BukaDashboardBankSoal()
deactivate Control

Guru -> UI : 12. Memilih Metode Penambahan Soal
alt Metode Input Manual
    Guru -> UI : 13. Mengetik Soal & Pilihan Jawaban
else Metode Import Excel
    Guru -> UI : 14. Mengunggah File Soal Massal (Excel)
else Metode AI Generate
    Guru -> UI : 15. Memasukkan Topik (Prompt) AI
    activate UI
    UI -> Control : 16. RequestGenerateSoal(Prompt)
    activate Control
    Control -> AI : 17. GenerateSoal(Prompt)
    activate AI
    AI --> Control : 18. HasilSoal(List Soal Otomatis)
    deactivate AI
    Control --> UI : 19. TampilkanDraftSoal(Data)
    deactivate Control
    Guru -> UI : 20. Me-review & Menyortir Soal AI
end

UI -> Control : 21. SimpanSeluruhBankSoal(ID_Latihan, DataSoal)
activate Control
Control -> E_Latihan : 22. InsertSoal() & AktifkanStatusLatihan()
activate E_Latihan
deactivate E_Latihan
note right of E_Latihan : Konvensi Assumed Success diterapkan
Control --> UI : 23. NotifikasiSukses()
deactivate Control
UI --> Guru : 24. Latihan Berhasil Dibuat
deactivate UI

== Skenario B: Koreksi & Hasil Latihan ==

Guru -> UI : 25. Klik "Lihat Hasil & Koreksi"
activate UI
UI -> Control : 26. RequestRekapHasil(ID_Latihan)
activate Control
Control -> E_Latihan : 27. HitungSkorOtomatis(PilihanGanda)
activate E_Latihan
E_Latihan --> Control : 28. RekapSkorSementara()
deactivate E_Latihan
Control --> UI : 29. TampilkanDaftarNilai(Data)
deactivate Control

Guru -> UI : 30. Membuka Jawaban Esai Siswa
Guru -> UI : 31. Klik "Minta AI Suggestion" (Opsi Bantuan)
UI -> Control : 32. RequestKoreksiAI(TeksJawabanSiswa)
activate Control
Control -> AI : 33. AnalisisJawabanEsai(TeksJawabanSiswa)
activate AI
AI --> Control : 34. RekomendasiNilai()
deactivate AI
Control --> UI : 35. TampilkanRekomendasiNilai()
deactivate Control

Guru -> UI : 36. Menentukan Nilai Akhir, Feedback, & "Simpan Koreksi"
UI -> Control : 37. SimpanNilaiKoreksi(ID_Siswa, NilaiAkhir)
activate Control
Control -> E_Latihan : 38. AkumulasiTotalSkor()
activate E_Latihan
deactivate E_Latihan

Guru -> UI : 39. Aktifkan "Publikasikan Nilai"
UI -> Control : 40. BukaAksesNilaiSiswa(ID_Latihan)
Control -> E_Latihan : 41. UpdateStatusPublikasi(True)
activate E_Latihan
deactivate E_Latihan

Control --> UI : 42. NotifikasiSukses()
deactivate Control
UI --> Guru : 43. Nilai Akhir Dapat Dilihat Siswa
deactivate UI

@enduml
