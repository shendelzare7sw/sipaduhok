@startuml
title Sequence Diagram - Kelola Tahun Ajaran
autonumber

actor "Admin" as Admin
boundary "UI_KelolaTahunAjaran" as UI
control "Control_TahunAjaran" as Control
entity "T_TahunAjaran" as E_Tahun

== Skenario: Menampilkan Daftar Tahun Ajaran ==
Admin -> UI : 1. Mengakses Menu Tahun Ajaran
activate UI
UI -> Control : 2. RequestDaftarTahunAjaran()
activate Control
Control -> E_Tahun : 3. AmbilDataTahunAjaran()
activate E_Tahun
E_Tahun --> Control : 4. ReturnData()
deactivate E_Tahun
Control --> UI : 5. TampilkanDaftarTahunAjaran(Data)
deactivate Control
UI --> Admin : 6. Halaman Daftar Tahun Ajaran Terbuka
deactivate UI

== Skenario A: Tambah Data Tahun Ajaran ==
Admin -> UI : 7. Memilih Aksi "Tambah"
activate UI
UI --> Admin : 8. Menampilkan Form Tambah Data
Admin -> UI : 9. Mengisi Form & Klik Simpan
UI -> Control : 10. SubmitDataBaru(Data)
activate Control
Control -> E_Tahun : 11. InsertData(Data)
activate E_Tahun

alt Proses Berhasil
    E_Tahun --> Control : 12. StatusSukses
    Control --> UI : 13. Update Tampilan & Pesan Sukses
    UI --> Admin : 14. Data Tahun Ajaran Diperbarui
else Proses Gagal
    E_Tahun --> Control : 15. StatusGagal
    deactivate E_Tahun
    Control --> UI : 16. ReturnPesanError()
    UI --> Admin : 17. Menampilkan Pesan Error
end
deactivate Control
deactivate UI

== Skenario B: Edit Data Tahun Ajaran ==
Admin -> UI : 18. Klik ikon Edit pada Data Tertentu
activate UI
UI -> Control : 19. RequestDataDetail(ID_TahunAjaran)
activate Control
Control --> UI : 20. ReturnDataDetail()
deactivate Control
UI --> Admin : 21. Menampilkan Form Edit
Admin -> UI : 22. Mengubah Data & Klik Simpan
UI -> Control : 23. SubmitEditData(ID_TahunAjaran, DataBaru)
activate Control
Control -> E_Tahun : 24. UpdateData()
activate E_Tahun

alt Proses Berhasil
    E_Tahun --> Control : 25. StatusSukses
    Control --> UI : 26. Update Tampilan & Pesan Sukses
    UI --> Admin : 27. Data Tahun Ajaran Diperbarui
else Proses Gagal
    E_Tahun --> Control : 28. StatusGagal
    deactivate E_Tahun
    Control --> UI : 29. ReturnPesanError()
    UI --> Admin : 30. Menampilkan Pesan Error
end
deactivate Control
deactivate UI

== Skenario C: Hapus Data Tahun Ajaran ==
Admin -> UI : 31. Klik ikon Hapus pada Data Tertentu
activate UI
UI --> Admin : 32. Menampilkan Konfirmasi Hapus
alt Hapus = Ya
    Admin -> UI : 33. Mengonfirmasi Penghapusan
    UI -> Control : 34. ProsesHapusData(ID_TahunAjaran)
    activate Control
    Control -> E_Tahun : 35. DeleteData()
    activate E_Tahun
    
    alt Proses Berhasil
        E_Tahun --> Control : 36. StatusSukses
        Control --> UI : 37. Update Tampilan & Pesan Sukses
        UI --> Admin : 38. Data Tahun Ajaran Dihapus
    else Proses Gagal
        E_Tahun --> Control : 39. StatusGagal
        deactivate E_Tahun
        Control --> UI : 40. ReturnPesanError()
        UI --> Admin : 41. Menampilkan Pesan Error
    end
    deactivate Control
else Batal
    Admin -> UI : 42. Klik Batal
    UI --> Admin : 43. Kembali ke Daftar
end
deactivate UI

@enduml
