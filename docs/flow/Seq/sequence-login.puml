@startuml
title Sequence Diagram - Login
autonumber

actor "Semua Pengguna" as Pengguna
boundary "UI_Login" as UI
control "Control_Auth" as Control
entity "T_Pengguna" as E_Pengguna

Pengguna -> UI : 1. Mengakses Halaman Login
activate UI
UI --> Pengguna : 2. Menampilkan Form Login
Pengguna -> UI : 3. Memasukkan Username & Password, lalu Klik "Login"

UI -> Control : 4. SubmitLogin(Username, Password)
activate Control
Control -> E_Pengguna : 5. ValidasiKredensial(Username)
activate E_Pengguna

alt Username Ditemukan & Password Cocok
    E_Pengguna --> Control : 6. ReturnDataPengguna(Role, ID)
    Control -> Control : 7. Generate Session Auth
    Control --> UI : 8. RedirectKeDashboard(Role)
    UI --> Pengguna : 9. Halaman Dashboard Terbuka
else Username Tidak Ditemukan / Password Salah
    E_Pengguna --> Control : 10. Kredensial Tidak Valid
    deactivate E_Pengguna
    Control --> UI : 11. ReturnPesanError("Username atau Password Salah")
    UI --> Pengguna : 12. Menampilkan Pesan Error di Form Login
end

deactivate Control
deactivate UI

@enduml
