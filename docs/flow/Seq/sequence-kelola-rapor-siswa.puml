@startuml
title Sequence Diagram - UC20: Kelola Rapor Siswa
autonumber

actor "Wali Kelas" as Wali
boundary "UI_KelolaRapor" as UI
control "Control_Rapor" as Control
entity "T_Rapor" as E_Rapor
entity "T_Presensi" as E_Presensi

== Skenario: Menampilkan Daftar Siswa & Status Rapor ==

Wali -> UI : 1. Mengakses Menu Kelola Rapor Siswa
activate UI
UI -> Control : 2. RequestDataSiswa(Kelas)
activate Control
Control -> E_Rapor : 3. AmbilDataSiswaDanStatusRapor()
activate E_Rapor
E_Rapor --> Control : 4. DataDitemukan(Data)
deactivate E_Rapor
Control --> UI : 5. TampilkanDaftar(Data)
deactivate Control
UI --> Wali : 6. Halaman Daftar Siswa & Status Terbuka
deactivate UI

== Skenario: Generate Rapor Kosong ==

Wali -> UI : 7. Klik "Generate Rapor" (Single / Massal)
activate UI
UI -> Control : 8. GenerateDraftRapor(Array_ID)
activate Control
Control -> E_Rapor : 9. BuatDraftBaru(Berdasarkan Template & Mapel)
activate E_Rapor
deactivate E_Rapor
note right of E_Rapor : Assumed Success diterapkan
Control --> UI : 10. NotifikasiSukses()
deactivate Control
UI --> Wali : 11. Menampilkan Pesan Sukses
deactivate UI

== Skenario: Input Data & Nilai (Manual / Tarik Kehadiran) ==

Wali -> UI : 12. Klik "Edit Rapor" pada Siswa
activate UI
UI -> Control : 13. RequestFormNilai(ID_Siswa)
activate Control
Control --> UI : 14. TampilkanFormNilai()
deactivate Control

Wali -> UI : 15. Mengisi Nilai / Klik "Tarik Kehadiran Otomatis"
UI -> Control : 16. TarikDataKehadiran(ID_Siswa)
activate Control
Control -> E_Presensi : 17. HitungRekapPresensi()
activate E_Presensi
E_Presensi --> Control : 18. DataRekap()
deactivate E_Presensi
Control --> UI : 19. IsiOtomatisFormKehadiran(DataRekap)
deactivate Control

Wali -> UI : 20. Klik "Simpan Perubahan"
UI -> Control : 21. SimpanDraftRapor(Data)
activate Control
Control -> E_Rapor : 22. UpdateNilaiDanCatatan()
activate E_Rapor
deactivate E_Rapor
Control --> UI : 23. NotifikasiSukses()
deactivate Control
UI --> Wali : 24. Menampilkan Pesan Sukses
deactivate UI

== Skenario: Import / Export Excel (Massal) ==

Wali -> UI : 25. Klik "Export / Import Excel"
activate UI
UI -> Control : 26. ProsesFileExcel(File)
activate Control
Control -> E_Rapor : 27. UpdateNilaiMassal(DataExcel)
activate E_Rapor
deactivate E_Rapor
Control --> UI : 28. NotifikasiSukses()
deactivate Control
UI --> Wali : 29. Menampilkan Pesan Sukses
deactivate UI

== Skenario: Kirim Validasi ke Ketua PKBM ==

Wali -> UI : 30. Klik "Kirim Validasi ke Ketua"
activate UI
UI -> Control : 31. ProsesKirimValidasi(ID_Rapor)
activate Control
Control -> E_Rapor : 32. UpdateStatus("Menunggu Validasi Ketua") & Kunci Edit
activate E_Rapor
deactivate E_Rapor

Control -> Control : 33. Kirim Notifikasi ke Ketua PKBM

Control --> UI : 34. NotifikasiSukses()
deactivate Control
UI --> Wali : 35. Menampilkan Pesan Sukses
deactivate UI

== Skenario: Terbitkan Rapor ==

Wali -> UI : 36. Klik "Terbitkan Rapor"
activate UI
UI -> Control : 37. ProsesPenerbitan(ID_Rapor)
activate Control
Control -> E_Rapor : 38. CekStatusPersetujuan()
activate E_Rapor
E_Rapor --> Control : 39. StatusPersetujuan(Ketua, Bendahara)
deactivate E_Rapor

Control -> Control : 40. Memvalidasi Kelengkapan Syarat
alt Belum Lengkap
    Control --> UI : 41. ErrorPenerbitan("Persyaratan Validasi Belum Terpenuhi")
    UI --> Wali : 42. Menampilkan Pesan Error
else Sudah Lengkap
    Control -> E_Rapor : 43. UpdateStatus("DITERBITKAN")
    activate E_Rapor
    deactivate E_Rapor
    
    Control --> UI : 44. NotifikasiSukses()
    UI --> Wali : 45. Pesan Sukses (Rapor Kini Dapat Diakses Orang Tua)
end
deactivate Control
deactivate UI

@enduml
