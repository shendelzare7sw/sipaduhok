@startuml activity-input-nilai-akademik
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Guru Pengajar)|
start
:Mengakses Dashboard LMS Kelas;

|Sistem|
:Menampilkan Tab "Nilai Akademik";
:Memuat Daftar Siswa Aktif\ndan Rekap Nilai Semester Berjalan;

|Pengguna (Guru Pengajar)|
:Memilih Metode Input Nilai\n(Decision);

if (Metode Input?) then (Input Individual)
    :Klik "Edit" pada Baris Siswa Tertentu;
    
    |Sistem|
    :Menampilkan Form Edit Nilai\n(Tugas, Latihan, UH, PTS, PAS);
    
    |Pengguna (Guru Pengajar)|
    :Memasukkan/Mengubah Angka Nilai;
    :Klik "Simpan Perubahan";
    
elseif (Metode Input?) then (Input Massal di Tabel)
    :Mengisi Angka Nilai Langsung\npada Kolom Tabel Web (Data Grid);
    :Klik "Simpan Semua Perubahan\n(Batch Update)";
    
elseif (Metode Input?) then (Import Excel)
    :Klik "Download Template Excel";
    
    |Sistem|
    :Meng-generate File Excel (.xlsx)\nBerisi Nama Siswa & Kolom Kosong;
    
    |Pengguna (Guru Pengajar)|
    :Merekap Nilai secara Offline di Excel;
    :Mengunggah (Import) File Excel ke Sistem;
endif

|Sistem|
:Memvalidasi Format Angka (0-100);
:Menyimpan ke Database\n(Terekam sebagai Snapshot Input Guru);
:Secara Otomatis Menghitung Ulang\nRata-Rata & Nilai Akhir Siswa;

|Pengguna (Guru Pengajar)|
:Melihat Pembaruan Rata-rata\ndi Tabel Utama;
:Klik "Hitung Ulang (Recalculate)"\n(Opsional jika ingin memastikan kalkulasi);

|Sistem|
:Memperbarui Kalkulasi;
:Menyinkronkan Perubahan Data\nke Dashboard Wali Kelas;
:Menampilkan Pesan Sukses;

|Pengguna (Guru Pengajar)|
:Selesai Melakukan Input\nNilai Akademik Siswa;
stop
@enduml
