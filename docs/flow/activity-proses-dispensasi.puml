@startuml activity-dispensasi-kenaikan-kelas
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Admin / Bendahara)|
start
:Mengakses Menu\nKandidat Dispensasi\n(Kenaikan Kelas);

|Sistem|
:Menampilkan Daftar Siswa\n(Akademik Tuntas, Keuangan Menunggak);

|Pengguna (Admin / Bendahara)|
:Memilih Siswa (Status: Belum Diajukan);
:Klik Tombol "Ajukan";

|Sistem|
:Menampilkan Pop-up\n"Ajukan Izin Khusus";

|Pengguna (Admin / Bendahara)|
:Mengisi "Alasan Pengajuan";
:Klik "Kirim ke Ketua PKBM";

|Sistem|
:Menyimpan Data Pengajuan\n(Status berubah menjadi "MENUNGGU");
:Mengirim Notifikasi\nke Ketua PKBM;

|Ketua PKBM|
:Menerima Notifikasi & Mengakses\nDashboard Persetujuan;
:Melihat Detail Izin Khusus Siswa;
:Memilih Keputusan\n(Decision);

if (Keputusan?) then (Setujui)
    |Sistem|
    :Mengubah Status Pengajuan\nmenjadi "Disetujui";
    :Mengaktifkan Kelayakan (Eligibility)\nSiswa untuk Naik Kelas;
    :Mengirim Notifikasi Persetujuan\nke Admin;
else (Tolak)
    |Ketua PKBM|
    :Mengisi Alasan Penolakan;
    |Sistem|
    :Mengubah Status Pengajuan\nmenjadi "Ditolak";
    :Tetap Memblokir Sistem\nKenaikan Kelas Siswa;
    :Mengirim Notifikasi Penolakan\nke Admin;
endif

|Pengguna (Admin / Bendahara)|
:Melihat Status Akhir di Kolom\n"Status Pengajuan";
stop
@enduml
