@startuml class-diagram-akurat
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 14
skinparam packageStyle rectangle
skinparam linetype ortho

title Class Diagram (Design View) - SIPADUHOK
' Fokus: layer MODEL (Eloquent) + layer SERVICE (logika bisnis) + dependency eksternal.
' Melengkapi ERD: ERD = struktur data; diagram ini = perilaku/arsitektur OOP.
' Diselaraskan dengan kode nyata (app/Models, app/Services).

' ============================================================
package "Model - Core & Identitas" #DDECEF {
  class User {
    +id : int
    +email : string
    +role : string
    +role_id : int
    +is_active : bool
    --
    +isAdmin() : bool
    +isBendahara() : bool
    +isGuru() : bool
    +tenagaPendidik() : hasOne
    +siswa() : hasOne
    +hasRole(nama) : bool
  }
  class Role {
    +id : int
    +name : string
    +level : int
  }
  class Cabang {
    +id : int
    +nama_cabang : string
  }
  class TahunAjaran {
    +id : int
    +is_active : bool
    --
    +scopeAktif() : Builder
  }
  class TenagaPendidik {
    +id : int
    +user_id : int
    +nama_lengkap : string
  }
  class Siswa {
    +id : int
    +user_id : int
    +kelas_id : int
    +status : string
    --
    +getSisaPembayaranAttribute() : decimal
    +parents() : belongsToMany
    +wali() : belongsToMany
  }
  class StudentParent {
    +siswa_id : int
    +parent_id : int
    +is_financial_responsible : bool
    +can_access_academic : bool
  }
}

' ============================================================
package "Model - Akademik" #E2EFDA {
  class Kelas {
    +id : int
    +wali_kelas_id : int
    +jenjang : string
    --
    +siswa() : hasMany
    +waliKelas() : belongsTo
  }
  class MataPelajaran
  class JadwalPelajaran {
    +hari : string
    --
    +validasiBentrok() : bool
    +sinkronisasiRelasiGuru() : void
  }
  class GuruPengajarKelas {
    +tenaga_pendidik_id : int
    +kelas_id : int
    +mata_pelajaran_id : int
  }
  class WaliKelasAssignment
  class Pertemuan
}

' ============================================================
package "Model - Penilaian & LMS" #FFF2CC {
  class Nilai {
    +nilai : decimal
    +guru_id : int
    +edited_by_wali_id : int
  }
  class Rapor {
    +status : string
    --
    +generatePDF() : PDF
  }
  class RaporNilai
  class Presensi
  class Materi
  class Tugas
  class TugasSiswa {
    +nilai : decimal
    +status : string
  }
  class Ujian {
    +jenis_ujian : string
  }
  class SoalUjian
  class UjianSiswa {
    +nilai : decimal
    +status : string
  }
  class JawabanSiswa
  class ForumDiskusi
  class ForumReply
  class LmsMeeting
}

' ============================================================
package "Model - Keuangan" #F8D7DA {
  class Tagihan {
    +jenis_tagihan : string
    +jumlah : decimal
    +status : string
    +tagihan_asal_id : int
    +dialihkan_ke_id : int
    --
    +updateStatusBayar() : void
    +scopeBelumLunasOriginal() : Builder
    +getSisaTagihanAttribute() : decimal
  }
  class Pembayaran {
    +metode_pembayaran : string
    +status_validasi : string
    +paid_by_parent_id : int
  }
}

' ============================================================
package "Service - Logika Bisnis" #E2D9F3 {
  class PromotionService {
    +checkFinancial(siswa) : bool
    +checkNilai(siswa) : bool
    +checkPresensi(siswa) : bool
    +prosesKenaikan(ta) : void
  }
  class TunggakanCarryoverService {
    +carryover(taLama, taBaru) : void
  }
  class ValidasiAksesService {
    +cekAksesUjian(siswa) : bool
    +cekAksesRapor(siswa) : bool
  }
  class NotificationService {
    +notifyTagihanMassal() : void
    +notifyHasilKenaikanKelas() : void
    +notifyKelasVirtualBaru() : void
    +notifyAbsensiAlpha() : void
  }
  class MidtransService {
    +requestToken(tagihan) : string
    +handleNotification(payload) : void
  }
}

' ============================================================
package "External" #F5F5F5 {
  class "AI (Groq/Gemini)" as AI <<external>> {
    +generateSoal() : JSON
    +autoGrade() : JSON
  }
  class "Midtrans API" as MidtransAPI <<external>>
  class Storage <<external>>
}

' ============================================================
' RELATIONSHIPS - Model layer (asosiasi)
' ============================================================
User "1" -- "0..1" TenagaPendidik
User "1" -- "0..1" Siswa
User "*" -- "0..1" Role
User "*" -- "1" Cabang
Siswa "1" -- "*" StudentParent
User "1" -- "*" StudentParent : sebagai wali

Kelas "*" -- "1" TahunAjaran
Kelas "1" -- "*" Siswa
Kelas "*" -- "0..1" TenagaPendidik : wali_kelas
JadwalPelajaran "*" -- "1" Kelas
JadwalPelajaran "*" -- "1" TenagaPendidik
GuruPengajarKelas "*" -- "1" TenagaPendidik
GuruPengajarKelas "*" -- "1" Kelas
GuruPengajarKelas "*" -- "1" MataPelajaran

Nilai "*" -- "1" Siswa
Nilai "*" -- "1" TenagaPendidik : guru
Rapor "1" -- "*" RaporNilai
RaporNilai "*" -- "1" Nilai
Presensi "*" -- "1" Siswa
Tugas "1" -- "*" TugasSiswa
Ujian "1" -- "*" SoalUjian
Ujian "1" -- "*" UjianSiswa
UjianSiswa "1" -- "*" JawabanSiswa
ForumDiskusi "1" -- "*" ForumReply

Tagihan "1" -- "*" Pembayaran
Tagihan "*" -- "1" Siswa
Tagihan "0..1" -- "0..1" Tagihan : carryover

' RELATIONSHIPS - Service layer (dependency ke Model & External)
PromotionService ..> Siswa
PromotionService ..> Tagihan
PromotionService ..> Nilai
PromotionService ..> NotificationService
TunggakanCarryoverService ..> Tagihan
ValidasiAksesService ..> Siswa
ValidasiAksesService ..> Tagihan
NotificationService ..> User
MidtransService ..> Pembayaran
MidtransService ..> MidtransAPI
Ujian ..> AI
Materi ..> Storage

@enduml
