@startuml
title Sequence Diagram - UC04: Kelola Tahun Ajaran
autonumber

actor "Admin / Waka" as Admin
boundary "UI_KelolaTahunAjaran" as UI
control "Control_TahunAjaran" as Control
entity "T_TahunAjaran" as Entity

== Skenario: Menampilkan Daftar Data Tahun Ajaran ==

Admin -> UI : 1. Mengakses Menu Tahun Ajaran
activate UI
UI -> Control : 2. RequestDaftarTahunAjaran()
activate Control
Control -> Entity : 3. AmbilDataTahunAjaran()
activate Entity
Entity --> Control : 4. DataDitemukan(Data)
deactivate Entity
Control --> UI : 5. TampilkanDaftarData(Data)
deactivate Control
UI --> Admin : 6. Daftar Data Tahun Ajaran Terbuka
deactivate UI

== Skenario: Tambah Data ==

Admin -> UI : 7. Pilih Aksi "Tambah"
activate UI
UI --> Admin : 8. Menampilkan Form Tambah Tahun Ajaran

Admin -> UI : 9. Isi Form Tahun Ajaran
Admin -> UI : 10. Klik Tombol Simpan
UI -> Control : 11. SimpanDataTahunAjaran(Data)
activate Control

Control -> Control : 12. Proses Validasi
alt Validasi Gagal
    Control --> UI : 13. ErrorValidasi(Pesan)
    UI --> Admin : 14. Menampilkan Pesan Error
else Validasi Berhasil
    Control -> Entity : 15. InsertData(Data)
    activate Entity
    deactivate Entity
    
    Control --> UI : 16. Notifikasi Berhasil()
    UI --> Admin : 17. Memperbarui Data Tahun Ajaran (Tabel Refresh)
end
deactivate Control
deactivate UI

== Skenario: Edit Data ==

Admin -> UI : 18. Klik ikon Edit pada Data Tahun Ajaran
activate UI
UI --> Admin : 19. Menampilkan Form Edit Tahun Ajaran

Admin -> UI : 20. Mengubah Data Tahun Ajaran
Admin -> UI : 21. Klik Tombol Simpan
UI -> Control : 22. UpdateDataTahunAjaran(Data)
activate Control

Control -> Control : 23. Proses Validasi
alt Validasi Gagal
    Control --> UI : 24. ErrorValidasi(Pesan)
    UI --> Admin : 25. Menampilkan Pesan Error
else Validasi Berhasil
    Control -> Entity : 26. UpdateData(Data)
    activate Entity
    deactivate Entity
    
    Control --> UI : 27. Notifikasi Berhasil()
    UI --> Admin : 28. Memperbarui Data Tahun Ajaran (Tabel Refresh)
end
deactivate Control
deactivate UI

== Skenario: Hapus Data ==

Admin -> UI : 29. Klik ikon Hapus pada Data Tahun Ajaran
activate UI
UI --> Admin : 30. Menampilkan Konfirmasi Hapus

Admin -> UI : 31. Setuju Hapus Data
UI -> Control : 32. HapusDataTahunAjaran(ID)
activate Control

Control -> Entity : 33. DeleteData(ID)
activate Entity

alt Proses Gagal (Constraint/Data Terikat)
    Entity --> Control : 34. Proses Gagal(Pesan)
    Control --> UI : 35. ErrorHapus(Pesan)
    UI --> Admin : 36. Menampilkan Pesan Error
else Proses Berhasil
    deactivate Entity
    Control --> UI : 37. Notifikasi Berhasil()
    UI --> Admin : 38. Memperbarui Data Tahun Ajaran (Tabel Refresh)
end
deactivate Control
deactivate UI

@enduml
