@startuml
title Sequence Diagram - Kelola Kelas Virtual
autonumber

actor "Guru" as Guru
boundary "UI_KelasVirtual" as UI
control "Control_Virtual" as Control
entity "T_KelasVirtual" as E_Virtual

== Skenario: Menampilkan Daftar Jadwal Virtual ==

Guru -> UI : 1. Mengakses Dashboard LMS (Tab Pertemuan Virtual)
activate UI
UI -> Control : 2. RequestDaftarPertemuan(Kelas)
activate Control
Control -> E_Virtual : 3. AmbilDataPertemuan()
activate E_Virtual
E_Virtual --> Control : 4. DataPertemuanDitemukan(Data)
deactivate E_Virtual
Control --> UI : 5. TampilkanDaftarPertemuan(Data)
deactivate Control
UI --> Guru : 6. Daftar Jadwal Pertemuan Terbuka
deactivate UI

== Skenario A: Buat Jadwal Baru (dengan Duplikasi) ==

Guru -> UI : 7. Klik "Jadwalkan Pertemuan" & Mengisi Form
activate UI
Guru -> UI : 8. Mengisi Judul, Platform, Link, & Waktu
Guru -> UI : 9. Memilih Opsi "Duplikasi ke Kelas Lain"
Guru -> UI : 10. Klik "Simpan"
UI -> Control : 11. SubmitJadwalBaru(Data)
activate Control
Control -> Control : 12. Memvalidasi Input

Control -> E_Virtual : 13. InsertDataJadwal()
activate E_Virtual
deactivate E_Virtual
note right of E_Virtual : Konvensi Assumed Success diterapkan

alt Opsi Duplikasi Aktif
    Control -> E_Virtual : 14. Looping InsertDataJadwal (Ke Kelas Tambahan)
    activate E_Virtual
    deactivate E_Virtual
end

Control --> UI : 15. NotifikasiSukses()
deactivate Control
UI --> Guru : 16. Pesan Sukses (Jadwal Berhasil Dibuat)
deactivate UI

== Skenario B: Edit Jadwal (dengan Update Serentak) ==

Guru -> UI : 17. Klik "Edit" pada Jadwal Tertentu
activate UI
UI -> Control : 18. RequestFormEdit(ID_Jadwal)
activate Control
Control --> UI : 19. TampilkanFormEdit()
deactivate Control

Guru -> UI : 20. Mengubah Data & Memilih "Update Semua Kelas Terkait"
Guru -> UI : 21. Klik "Simpan Perubahan"
UI -> Control : 22. UpdateDataJadwal(DataEdit)
activate Control

Control -> E_Virtual : 23. UpdateData()
activate E_Virtual
deactivate E_Virtual

alt Opsi Update Semua Aktif
    Control -> E_Virtual : 24. Looping UpdateData (Pada Jadwal Duplikat)
    activate E_Virtual
    deactivate E_Virtual
end

Control --> UI : 25. NotifikasiSukses()
deactivate Control
UI --> Guru : 26. Pesan Sukses
deactivate UI

== Skenario C: Hapus Jadwal ==

Guru -> UI : 27. Klik "Hapus" pada Jadwal
activate UI
UI --> Guru : 28. Tampilkan Konfirmasi Hapus (Opsi: Hapus Beserta Duplikat)
Guru -> UI : 29. Mengonfirmasi Penghapusan
UI -> Control : 30. ProsesHapusJadwal(ID_Jadwal, HapusDuplikat)
activate Control

Control -> E_Virtual : 31. DeleteDataJadwal()
activate E_Virtual
deactivate E_Virtual

alt Opsi Hapus Beserta Duplikat = True
    Control -> E_Virtual : 32. Looping DeleteDataJadwal (Pada Kelas Lain)
    activate E_Virtual
    deactivate E_Virtual
end

Control --> UI : 33. NotifikasiSukses()
deactivate Control
UI --> Guru : 34. Pesan Sukses
deactivate UI

@enduml
