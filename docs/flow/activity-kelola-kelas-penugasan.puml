@startuml activity-kelola-kelas-penugasan
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Admin)|
start
:Mengakses Menu\nData Kelas & Penugasan;

|Sistem|
:Menampilkan *Dropdown* Menu\nKelas & Penugasan;

|Pengguna (Admin)|
:Memilih Kategori Pengelolaan;

if (Kategori Pengelolaan?) then (Data Kelas)
    |Sistem|
    :Menampilkan Halaman\nData Kelas;
    |Pengguna (Admin)|
    :Melakukan Aksi CRUD\n(Tambah / Edit / Hapus);
    :Klik "Simpan" / "Konfirmasi";
    |Sistem|
    :Memproses Perubahan\nData ke Database;
    :Menampilkan Pesan Sukses;

elseif (Kategori Pengelolaan?) then (Wali Kelas)
    |Sistem|
    :Menampilkan Halaman\nPenugasan Wali;
    |Pengguna (Admin)|
    :Memilih Kelas &\nAssign Wali Kelas;
    :Klik Tombol "Simpan Penugasan";
    |Sistem|
    if (Validasi Penugasan?) then (Valid)
        :Menyimpan Relasi Wali Kelas\nke Database;
        :Menampilkan Pesan Sukses;
    else (Tidak Valid / Bentrok)
        :Menampilkan Pesan Error\n(Contoh: "Wali kelas sudah\nditugaskan");
        |Pengguna (Admin)|
        :Memperbaiki Pilihan;
        note right: Kembali ke Form Penugasan
    endif

elseif (Kategori Pengelolaan?) then (Guru Pengajar)
    |Sistem|
    :Menampilkan Halaman\nData Guru Pengajar;
    |Pengguna (Admin)|
    :Melihat Daftar Penugasan Guru\n*(Read-Only)*;
    :Klik "Sinkronisasi dari Jadwal";
    |Sistem|
    :Menarik Data Relasi dari\nModul Jadwal Pelajaran;
    :Memperbarui Tampilan\nData Guru Pengajar;

else (Manajemen Siswa)
    |Sistem|
    :Menampilkan Halaman\nManajemen Siswa;
    |Pengguna (Admin)|
    :Melihat Detail Informasi Siswa;
    :Klik Tombol "Cetak Kartu";
    |Sistem|
    :Men-generate PDF\nKartu Pelajar Siswa;
endif

|Pengguna (Admin)|
:Selesai Melakukan\nPengelolaan;
stop
@enduml
