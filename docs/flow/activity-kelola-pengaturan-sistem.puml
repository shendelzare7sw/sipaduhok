@startuml activity-kelola-pengaturan-sistem
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ArrowColor #A80036

|Pengguna (Admin)|
start
:Mengakses Menu\nPengaturan Sistem;

|Sistem|
:Menampilkan *Dropdown*\nMenu Pengaturan;

|Pengguna (Admin)|
:Memilih Kategori Pengaturan\n(Decision);

if (Pilih Kategori?) then (Pengaturan LMS)
    |Sistem|
    :Menampilkan Form\nPengaturan LMS;
    |Pengguna (Admin)|
    :Mengubah Konfigurasi LMS\n(Integrasi Google Workspace, dll);
    :Klik Tombol "Simpan Pengaturan LMS";

else (Pengaturan AI)
    |Sistem|
    :Menampilkan Form\nPengaturan AI;
    |Pengguna (Admin)|
    :Mengubah Konfigurasi AI\n(Input API Key Groq/Gemini);
    :Klik Tombol "Simpan Pengaturan AI";
endif

|Sistem|
if (Validasi Input?) then (Sesuai Format)
    :Menyimpan Konfigurasi Baru\nke Database / Server;
    :Menampilkan Pesan Sukses;
else (Tidak Sesuai)
    :Menampilkan Pesan Error\n(Format Salah/Kosong);
    |Pengguna (Admin)|
    :Memperbaiki Input Data;
    note right: Kembali Memperbaiki Form
endif

|Pengguna (Admin)|
:Melihat Hasil Pembaruan;
stop
@enduml
