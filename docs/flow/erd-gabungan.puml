@startuml erd-gabungan
' ERD Gabungan SIPADUHOK - overview seluruh entitas (58 tabel)
' Notasi: crow's-foot (IE). ||=satu, {=banyak, o=opsional/nullable.
!theme plain
hide circle
hide empty members
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 40
left to right direction

package "A. Pengguna, Peran & Organisasi" {
  entity "roles" as roles
