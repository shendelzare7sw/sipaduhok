@startuml erd
!theme plain
hide circle
hide empty methods
skinparam linetype ortho
skinparam classFontSize 12
skinparam packageFontSize 14
skinparam packageStyle rectangle

title ERD - SIPADUHOK (diturunkan dari skema database aktual, 51 migration)
' Catatan: hanya tabel domain yang ditampilkan. Tabel framework (migrations, cache,
' jobs, sessions, password_reset_tokens, failed_jobs, personal_access_tokens,
' kelas_duplicate_backup) sengaja tidak digambar.
' Notasi kaki-gagak: || = tepat satu, o| = nol/satu, o{ = nol/banyak.

' ============================================================
package "Core" #DDECEF {
  entity users {
    * id : bigint <<PK>>
    --
    name
    email <<unique>>
    role
    role_id : bigint <<FK>>
    is_active : bool
    cabang_id : bigint <<FK>>
  }
  entity roles {
    * id : bigint <<PK>>
    --
    name
    level : int
  }
  entity cabang {
    * id : bigint <<PK>>
    --
    nama_cabang
    is_active : bool
  }
  entity tahun_ajaran {
    * id : bigint <<PK>>
    --
    nama
    semester
    is_active : bool
  }
  entity app_settings {
    * id : bigint <<PK>>
    --
    key <<unique>>
    value
  }
  entity recovery_tickets {
    * id : bigint <<PK>>
    --
    user_id : bigint <<FK>>
    status
  }
}

' ============================================================
package "Identitas Peran" #EAF3D8 {
  entity tenaga_pendidik {
    * id : bigint <<PK>>
    --
    user_id : bigint <<FK>>
    nama_lengkap
    jenis_kelamin
    nip
  }
  entity siswa {
    * id : bigint <<PK>>
    --
    user_id : bigint <<FK>>
    cabang_id : bigint <<FK>>
    kelas_id : bigint <<FK>> (nullable)
    nisn <<unique>>
    nama_lengkap
    status : aktif|lulus|pindah|keluar
    validasi_ujian_oleh : bigint <<FK>>
    validasi_rapor_oleh : bigint <<FK>>
  }
  entity student_parents {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    parent_id : bigint <<FK>> (users)
    is_primary : bool
    is_financial_responsible : bool
    can_access_academic : bool
  }
}

' ============================================================
package "Akademik" #E2EFDA {
  entity kelas {
    * id : bigint <<PK>>
    --
    cabang_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    wali_kelas_id : bigint <<FK>> (nullable)
    nama_kelas
    jenjang
    kode_kelas
  }
  entity mata_pelajaran {
    * id : bigint <<PK>>
    --
    kode_mapel
    nama_mapel
    jenjang
  }
  entity jadwal_pelajaran {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>> (tenaga_pendidik)
    tahun_ajaran_id : bigint <<FK>>
    hari
    jam_mulai / jam_selesai
  }
  entity jadwal_kelas {
    * id : bigint <<PK>>
    --
    jadwal_pelajaran_id : bigint <<FK>>
    kelas_id : bigint <<FK>>
  }
  entity jadwal_pelajaran_history {
    * id : bigint <<PK>>
    --
    jadwal_pelajaran_id : bigint <<FK>>
    changed_by : bigint <<FK>>
  }
  entity guru_pengajar_kelas {
    * id : bigint <<PK>>
    --
    tenaga_pendidik_id : bigint <<FK>>
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
  }
  entity wali_kelas_assignments {
    * id : bigint <<PK>>
    --
    tenaga_pendidik_id : bigint <<FK*>>
    kelas_id : bigint <<FK*>>
    tahun_ajaran_id : bigint <<FK*>>
  }
  entity pertemuans {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>>
  }
}

' ============================================================
package "Penilaian & Presensi" #FFF2CC {
  entity nilai {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    kelas_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>>
    edited_by_wali_id : bigint <<FK>>
    nilai : decimal
  }
  entity presensi {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    diinput_oleh : bigint <<FK>>
    status : hadir|sakit|izin|alpha
    tanggal
  }
  entity rapor {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    kelas_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    semester
    status
  }
  entity rapor_nilai {
    * id : bigint <<PK>>
    --
    rapor_id : bigint <<FK>>
    nilai_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
  }
  entity rapor_kegiatan_ekstra {
    * id : bigint <<PK>>
    --
    rapor_id : bigint <<FK>>
  }
}

' ============================================================
package "Kenaikan Kelas" #E2D9F3 {
  entity pengaturan_kkm {
    * id : bigint <<PK>>
    --
    mata_pelajaran_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    nilai_kkm : decimal
  }
  entity pengaturan_naik_kelas {
    * id : bigint <<PK>>
    --
    tahun_ajaran_id : bigint <<FK>>
  }
  entity status_naik_kelas_siswa {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    original_kelas_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    rolled_back_by : bigint <<FK>>
    status
  }
  entity izin_naik_kelas_khusus {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    diajukan_oleh : bigint <<FK>>
    disetujui_oleh : bigint <<FK>>
    status
  }
  entity promotion_schedules {
    * id : bigint <<PK>>
    --
    tahun_ajaran_id : bigint <<FK>>
    created_by : bigint <<FK>>
  }
  entity pengajuan_rapor_ketua {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    diajukan_oleh : bigint <<FK>>
    diputuskan_oleh : bigint <<FK>>
    status
  }
  entity template_capaian_kompetensi {
    * id : bigint <<PK>>
    --
    mata_pelajaran_id : bigint <<FK>>
    created_by : bigint <<FK>>
  }
}

' ============================================================
package "LMS" #D6E9F8 {
  entity materi {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>>
    pertemuan_id : bigint <<FK>>
    judul_materi
    tipe_file
  }
  entity tugas {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>>
    pertemuan_id : bigint <<FK>>
    deadline
  }
  entity tugas_siswa {
    * id : bigint <<PK>>
    --
    tugas_id : bigint <<FK>>
    siswa_id : bigint <<FK>>
    nilai : decimal
    status
  }
  entity ujian {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>>
    pertemuan_id : bigint <<FK>>
    jenis_ujian
  }
  entity soal_ujian {
    * id : bigint <<PK>>
    --
    ujian_id : bigint <<FK>>
    pertanyaan
    kunci_jawaban
  }
  entity ujian_siswa {
    * id : bigint <<PK>>
    --
    ujian_id : bigint <<FK>>
    siswa_id : bigint <<FK>>
    current_soal_ujian_id : bigint <<FK>>
    nilai : decimal
    status
  }
  entity jawaban_siswa {
    * id : bigint <<PK>>
    --
    ujian_siswa_id : bigint <<FK>>
    soal_ujian_id : bigint <<FK>>
    jawaban
  }
  entity ujian_siswa_soal_statuses {
    * id : bigint <<PK>>
    --
    ujian_siswa_id : bigint <<FK>>
    soal_ujian_id : bigint <<FK>>
  }
  entity ujian_pengawasan_logs {
    * id : bigint <<PK>>
    --
    ujian_siswa_id : bigint <<FK>>
    tipe_pelanggaran
  }
  entity forum_diskusi {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    pertemuan_id : bigint <<FK>>
    user_id : bigint <<FK>>
  }
  entity forum_replies {
    * id : bigint <<PK>>
    --
    forum_diskusi_id : bigint <<FK>>
    parent_id : bigint <<FK>> (self)
    user_id : bigint <<FK>>
  }
  entity lms_meetings {
    * id : bigint <<PK>>
    --
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
    guru_id : bigint <<FK>>
    link_meeting
  }
}

' ============================================================
package "Keuangan" #F8D7DA {
  entity tagihan {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    tahun_ajaran_id : bigint <<FK>>
    tagihan_asal_id : bigint <<FK>> (self, carryover)
    dialihkan_ke_id : bigint <<FK>> (self, carryover)
    jenis_tagihan
    jumlah : decimal
    status
  }
  entity pembayaran {
    * id : bigint <<PK>>
    --
    tagihan_id : bigint <<FK>>
    siswa_id : bigint <<FK>>
    paid_by_parent_id : bigint <<FK>> (users)
    divalidasi_oleh : bigint <<FK>> (users)
    metode_pembayaran
    status_validasi
  }
  entity pengaturan_batas_pembayaran {
    * id : bigint <<PK>>
    --
    tahun_ajaran_id : bigint <<FK>>
    created_by : bigint <<FK>>
  }
  entity info_pembayaran {
    * id : bigint <<PK>>
    --
    updated_by : bigint <<FK>>
    no_rekening
  }
  entity financial_audit_logs {
    * id : bigint <<PK>>
    --
    user_id : bigint <<FK>>
    aksi
  }
}

' ============================================================
package "Konten & Monitoring" #FDE9D9 {
  entity berita {
    * id : bigint <<PK>>
    --
    dibuat_oleh : bigint <<FK>>
  }
  entity flyer {
    * id : bigint <<PK>>
    --
    dibuat_oleh : bigint <<FK>>
  }
  entity pengumuman {
    * id : bigint <<PK>>
    --
    dibuat_oleh : bigint <<FK>>
    kalender_akademik_id : bigint <<FK>>
  }
  entity kalender_akademik {
    * id : bigint <<PK>>
    --
    tahun_ajaran_id : bigint <<FK>>
  }
  entity landing_pages {
    * id : bigint <<PK>>
  }
  entity landing_page_sections {
    * id : bigint <<PK>>
    --
    landing_page_id : bigint <<FK>>
  }
  entity catatan {
    * id : bigint <<PK>>
    --
    pengirim_id : bigint <<FK>>
    penerima_id : bigint <<FK>>
  }
  entity catatan_dibaca {
    * id : bigint <<PK>>
    --
    catatan_id : bigint <<FK>>
    user_id : bigint <<FK>>
  }
  entity catatan_monitoring {
    * id : bigint <<PK>>
    --
    pengirim_id : bigint <<FK>>
    guru_id : bigint <<FK>>
    kelas_id : bigint <<FK>>
    mata_pelajaran_id : bigint <<FK>>
  }
  entity notifications {
    * id : bigint <<PK>>
    --
    user_id : bigint <<FK>>
  }
  entity request_download_rapor {
    * id : bigint <<PK>>
    --
    siswa_id : bigint <<FK>>
    rapor_id : bigint <<FK>>
    user_id : bigint <<FK>>
    diputuskan_oleh : bigint <<FK>>
  }
}

' ============================================================
