' ============================================================
' EXTERNAL SERVICES
' ============================================================
package "External Service" #F5F5F5 {

    class Service_AI <<external>> {
        + generateSoal(topik, jumlah) : JSON
        + koreksiOtomatis(jawaban) : JSON
    }

    class Storage <<external>> {
        + uploadFile(file) : String
        + deleteFile(path) : Boolean
        + getFileUrl(path) : String
    }

    class API_Midtrans <<external>> {
        + requestToken(transaksi) : String
        + handleWebhook(notification) : void
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- Core Relationships ---
T_Pengguna "1" -- "0..*" T_Tiket : mengajukan >
T_Pengguna "*" -- "1" T_Cabang : berasal dari >
T_Pengguna -- RolePengguna

' --- Akademik Relationships ---
T_Kelas "*" -- "1" T_TahunAjaran : berlaku pada >
T_Kelas "*" -- "1" T_Cabang : milik >
T_Kelas "1" -- "0..*" T_Siswa : berisi >
T_Siswa "1" -- "1" T_Pengguna : akun >
T_Siswa "*" -- "0..1" T_Pengguna : wali >

T_PenugasanWali "0..1" -- "1" T_Kelas : ditugaskan di >
T_PenugasanWali "*" -- "1" T_Pengguna : guru wali >
T_PenugasanWali "*" -- "1" T_TahunAjaran

T_PenugasanGuru "*" -- "1" T_Pengguna : guru pengajar >
T_PenugasanGuru "*" -- "1" T_Kelas
T_PenugasanGuru "*" -- "1" T_MataPelajaran
T_PenugasanGuru "*" -- "1" T_TahunAjaran

T_JadwalPelajaran "*" -- "1" T_Kelas : untuk >
T_JadwalPelajaran "*" -- "1" T_MataPelajaran : mengajarkan >
T_JadwalPelajaran "*" -- "1" T_Pengguna : diampu oleh >
T_JadwalPelajaran "*" -- "1" T_TahunAjaran : berlaku pada >
T_LogJadwal "*" -- "1" T_JadwalPelajaran : mencatat >

' --- Penilaian Relationships ---
T_NilaiAkademik "*" -- "1" T_Siswa : milik >
T_NilaiAkademik "*" -- "1" T_MataPelajaran : untuk >
T_NilaiAkademik "*" -- "1" T_TahunAjaran
T_NilaiAkademik "*" -- "1" T_Pengguna : dinilai oleh >

T_Rapor "*" -- "1" T_Siswa : milik >
T_Rapor "*" -- "1" T_Kelas
T_Rapor "*" -- "1" T_TahunAjaran

' --- Presensi Relationships ---
T_Presensi "*" -- "1" T_Siswa : mencatat >
T_Presensi "*" -- "1" T_Kelas
T_Presensi "*" -- "1" T_MataPelajaran
T_Presensi "*" -- "1" T_Pengguna : oleh guru >

' --- Kenaikan Kelas Relationships ---
T_KKM "*" -- "1" T_MataPelajaran : untuk >
T_KKM "*" -- "1" T_TahunAjaran
T_SyaratKenaikan "*" -- "1" T_TahunAjaran

T_KelayakanKenaikan "*" -- "1" T_Siswa : mengevaluasi >
T_KelayakanKenaikan "*" -- "1" T_TahunAjaran

T_RiwayatKenaikan "*" -- "1" T_Siswa : mencatat >
T_RiwayatKenaikan "*" -- "1" T_TahunAjaran

T_DispensasiKenaikan "*" -- "1" T_Siswa : untuk >
T_DispensasiKenaikan "*" -- "1" T_TahunAjaran
T_DispensasiKenaikan "*" -- "1" T_Pengguna : diajukan oleh >

' --- LMS Relationships ---
T_ModulLMS "*" -- "1" T_MataPelajaran : berisi >
T_ModulLMS "*" -- "1" T_Kelas

T_Ujian "*" -- "1" T_MataPelajaran : untuk >
T_Ujian "*" -- "1" T_Kelas
T_Ujian "*" -- "1" T_Pengguna : dibuat oleh >
T_SesiUjian "*" -- "1" T_Ujian : sesi dari >
T_SesiUjian "*" -- "1" T_Siswa : dikerjakan oleh >

T_Latihan "*" -- "1" T_MataPelajaran
T_Latihan "*" -- "1" T_Kelas
T_Latihan "*" -- "1" T_Pengguna : dibuat oleh >

T_Materi "*" -- "1" T_MataPelajaran
T_Materi "*" -- "1" T_Kelas
T_Materi "*" -- "1" T_Pengguna : diunggah oleh >

T_Tugas "*" -- "1" T_MataPelajaran
T_Tugas "*" -- "1" T_Kelas
T_Tugas "*" -- "1" T_Pengguna : dibuat oleh >
T_TugasSiswa "*" -- "1" T_Tugas : jawaban dari >
T_TugasSiswa "*" -- "1" T_Siswa : dikerjakan oleh >

T_ForumTopik "*" -- "1" T_MataPelajaran
T_ForumTopik "*" -- "1" T_Kelas
T_ForumTopik "*" -- "1" T_Pengguna : dibuat oleh >
T_ForumBalasan "*" -- "1" T_ForumTopik : membalas >
T_ForumBalasan "*" -- "1" T_Pengguna : ditulis oleh >

T_KelasVirtual "*" -- "1" T_MataPelajaran
T_KelasVirtual "*" -- "1" T_Kelas
T_KelasVirtual "*" -- "1" T_Pengguna : diselenggarakan oleh >

' --- Keuangan Relationships ---
T_Tagihan "*" -- "1" T_Siswa : ditagihkan ke >
T_Tagihan "*" -- "1" T_TahunAjaran
T_Pembayaran "*" -- "1" T_Tagihan : membayar >

T_Dispensasi "*" -- "1" T_Siswa : untuk >
T_Dispensasi "*" -- "1" T_Pengguna : diajukan oleh >

T_ValidasiAkses "*" -- "1" T_Siswa : mengatur akses >
T_ValidasiAkses "*" -- "1" T_TahunAjaran

' --- Monitoring Relationships ---
T_Laporan "*" -- "1" T_Pengguna : dibuat oleh >
T_Laporan "*" -- "1" T_TahunAjaran

T_CatatanMonitoring "*" -- "1" T_Pengguna : pengirim >
T_CatatanMonitoring "*" -- "1" T_Pengguna : penerima >

T_PermintaanUnduh "*" -- "1" T_Siswa : dari >
T_PermintaanUnduh "*" -- "1" T_Rapor : untuk >

' --- Portal Relationships ---
T_Publikasi "*" -- "1" T_Pengguna : ditulis oleh >

' --- External Service Usage (Dependencies) ---
T_Ujian ..> Service_AI : menggunakan
T_Latihan ..> Service_AI : menggunakan
T_Materi ..> Storage : menyimpan file
T_Pembayaran ..> API_Midtrans : request token

@enduml
