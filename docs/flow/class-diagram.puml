@startuml class-diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 14
skinparam packageStyle rectangle
skinparam linetype ortho

title Class Diagram - Sistem Informasi PKBM Duhok (SIPADUHOK)

' ============================================================
' PACKAGE: CORE (Pengguna, Cabang, Tahun Ajaran, Pengaturan)
' ============================================================
package "Core" #DDECEF {

    enum RolePengguna {
        ADMIN
        KETUA_PKBM
        WAKIL_KEPALA_SEKOLAH
        SEKRETARIS
        BENDAHARA
        GURU
        WALI_KELAS
        SISWA
        WALI_SISWA
    }

    class T_Pengguna {
        - id : Integer <<PK>>
        - username : String
        - password : String
        - nama : String
        - email : String
        - no_telp : String
        - role : RolePengguna
        - foto : String
        - id_cabang : Integer <<FK>>
        - is_aktif : Boolean
        - created_at : DateTime
        - updated_at : DateTime
        --
        + login(username, password) : Boolean
        + logout() : void
        + resetPassword(passwordBaru) : void
        + generateSession() : String
        + destroySession() : void
    }

    class T_Cabang {
        - id : Integer <<PK>>
        - nama_cabang : String
        - alamat : Text
        - no_telp : String
        - email : String
        - kepala_cabang : String
        - is_aktif : Boolean
        - created_at : DateTime
        - updated_at : DateTime
    }

    class T_TahunAjaran {
        - id : Integer <<PK>>
        - nama : String
        - semester : Enum(Ganjil, Genap)
        - tanggal_mulai : Date
        - tanggal_selesai : Date
        - is_aktif : Boolean
        - created_at : DateTime
        - updated_at : DateTime
        --
        + getAktif() : T_TahunAjaran
    }

    class T_Pengaturan {
        - id : Integer <<PK>>
        - kategori : Enum(LMS, AI)
        - kunci : String
        - nilai : Text
        - deskripsi : String
        - updated_at : DateTime
        --
        + getConfigByKategori(kategori) : List
        + updateConfig(kunci, nilai) : Boolean
    }

    class T_Tiket {
        - id : Integer <<PK>>
        - id_pengguna : Integer <<FK>>
        - jenis_masalah : String
        - deskripsi : Text
        - status : Enum(Baru, Proses, Selesai)
        - tanggal_pengajuan : DateTime
        - tanggal_selesai : DateTime
    }
}

' ============================================================
' PACKAGE: AKADEMIK (Kelas, Mapel, Jadwal, Penugasan, Siswa)
' ============================================================
package "Akademik" #E2EFDA {

    class T_Kelas {
        - id : Integer <<PK>>
        - nama_kelas : String
        - jenjang : Enum(SD, SMP, SMA)
        - id_tahun_ajaran : Integer <<FK>>
        - id_cabang : Integer <<FK>>
        - kapasitas : Integer
        - created_at : DateTime
        - updated_at : DateTime
    }

    class T_Siswa {
        - id : Integer <<PK>>
        - id_pengguna : Integer <<FK>>
        - id_kelas : Integer <<FK>>
        - nis : String
        - nama_lengkap : String
        - jenis_kelamin : Enum(L, P)
        - tanggal_lahir : Date
        - alamat : Text
        - id_wali : Integer <<FK>>
        - created_at : DateTime
        --
        + cetakKartuPelajar() : PDF
    }

    class T_MataPelajaran {
        - id : Integer <<PK>>
        - nama_mapel : String
        - kode_mapel : String
        - jenjang : Enum(SD, SMP, SMA)
        - deskripsi : Text
        - is_aktif : Boolean
    }

    class T_JadwalPelajaran {
        - id : Integer <<PK>>
        - id_kelas : Integer <<FK>>
        - id_mapel : Integer <<FK>>
        - id_guru : Integer <<FK>>
        - hari : Enum(Senin..Minggu)
        - jam_mulai : Time
        - jam_selesai : Time
        - id_tahun_ajaran : Integer <<FK>>
        --
        + validasiKesesuaianJenjang() : Boolean
        + validasiBentrok() : Boolean
        + sinkronisasiRelasiGuru() : void
    }

    class T_PenugasanWali {
        - id : Integer <<PK>>
        - id_kelas : Integer <<FK>>
        - id_guru : Integer <<FK>>
        - id_tahun_ajaran : Integer <<FK>>
        --
        + validasiBentrok() : Boolean
    }

    class T_PenugasanGuru {
        - id : Integer <<PK>>
        - id_guru : Integer <<FK>>
        - id_kelas : Integer <<FK>>
        - id_mapel : Integer <<FK>>
        - id_tahun_ajaran : Integer <<FK>>
        --
        + sinkronisasiDariJadwal() : void
    }

    class T_LogJadwal {
        - id : Integer <<PK>>
        - id_jadwal : Integer <<FK>>
        - id_guru_lama : Integer <<FK>>
        - id_guru_baru : Integer <<FK>>
        - alasan : Text
        - tipe : Enum(Individual, Massal)
        - tanggal_perubahan : DateTime
    }
}

