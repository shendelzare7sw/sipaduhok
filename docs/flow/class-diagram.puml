package "Keuangan" #F8D7DA {

    class T_Tagihan {
        - id : Integer <<PK>>
        - id_siswa : Integer <<FK>>
        - id_tahun_ajaran : Integer <<FK>>
        - jenis_tagihan : Enum(SPP, Lainnya)
        - bulan : Integer
