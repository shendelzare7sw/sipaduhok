@startuml
title Sequence Diagram - Melakukan Pembayaran
autonumber

actor "Wali Siswa / Siswa" as Pengguna
boundary "UI_Pembayaran" as UI
control "Control_Pembayaran" as Control
entity "T_Pembayaran" as E_Pembayaran
entity "T_Tagihan" as E_Tagihan
participant "API_Midtrans" as Midtrans

== Skenario: Menampilkan Form Pembayaran ==
Pengguna -> UI : 1. Mengakses Detail Tagihan & Klik "Bayar"
activate UI
UI -> Control : 2. RequestFormPembayaran(ID_Tagihan)
activate Control
Control -> E_Tagihan : 3. CekStatusTagihan()
activate E_Tagihan
E_Tagihan --> Control : 4. ReturnStatus()
deactivate E_Tagihan
Control --> UI : 5. TampilkanFormPembayaran()
deactivate Control
UI --> Pengguna : 6. Form Pembayaran Terbuka
deactivate UI

== Skenario: Proses Pembayaran (Manual & Midtrans) ==
Pengguna -> UI : 7. Memilih Metode, Input Nominal, (Opsional) Upload Bukti
activate UI
Pengguna -> UI : 8. Klik "Proses Pembayaran"
UI -> Control : 9. SubmitPembayaran(Data)
activate Control

Control -> Control : 10. Validasi Input & Aturan Bisnis
alt Tagihan Lama (Belum di-Carryover)
    Control --> UI : 11. ReturnPesanError("Tagihan lama harus dialihkan Bendahara")
    UI --> Pengguna : 12. Menampilkan Pesan Error
else Metode Manual & Upload Kosong
    Control --> UI : 13. ReturnPesanError("Bukti Transfer wajib diunggah")
    UI --> Pengguna : 14. Menampilkan Pesan Error
else Validasi Sukses
    Control -> Control : 15. GenerateKodePembayaran(PAY-XXXXX)
    Control -> E_Pembayaran : 16. InsertRecordPembayaran()
    activate E_Pembayaran
    deactivate E_Pembayaran
    
    alt Metode = Transfer Manual
        Control -> E_Pembayaran : 17. SetStatus("Pending")
        activate E_Pembayaran
        deactivate E_Pembayaran
        Control --> UI : 18. NotifikasiSukses()
        UI --> Pengguna : 19. Pesan Sukses (Menunggu Validasi Bendahara)
    else Metode = Midtrans
        Control -> Midtrans : 20. RequestToken()
        activate Midtrans
        Midtrans --> Control : 21. Token Transaksi
        deactivate Midtrans
        
        Control -> E_Pembayaran : 22. SetStatus("Menunggu Pembayaran")
        activate E_Pembayaran
        deactivate E_Pembayaran
        
        Control --> UI : 23. RedirectKeGateway(Token)
        UI --> Pengguna : 24. Menampilkan Pop-up Pembayaran / Midtrans UI
        Pengguna -> Midtrans : 25. Menyelesaikan Pembayaran (VA / E-Wallet)
        activate Midtrans
        Midtrans -> Control : 26. Webhook Notification (Lunas)
        deactivate Midtrans
        
        Control -> E_Pembayaran : 27. UpdateStatus("Lunas")
        activate E_Pembayaran
        deactivate E_Pembayaran
        Control -> E_Tagihan : 28. UpdateSisaTagihan()
        activate E_Tagihan
        deactivate E_Tagihan
    end
end
deactivate Control
deactivate UI

== Skenario: Melihat Riwayat & Cetak Bukti ==
Pengguna -> UI : 29. Membuka Riwayat Pembayaran & Klik "Cetak Bukti"
activate UI
UI -> Control : 30. RequestCetakBukti(ID_Pembayaran)
activate Control
Control -> Control : 31. Generate PDF Bukti Bayar
Control --> UI : 32. ReturnFilePDF()
deactivate Control
UI --> Pengguna : 33. Unduhan Bukti Pembayaran PDF
deactivate UI

@enduml